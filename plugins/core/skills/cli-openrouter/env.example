# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/cli-openrouter/.env (or to .env in this skill's directory).
# openrouter-cli reads the environment first, then that file, then the skill-directory .env.
# Set one of the two; when the command is set, the key line is ignored.

# A shell command that prints the key (no quotes inside the value); a failing command stops
# the run. Example for a macOS login-keychain item:
#AI_OPENROUTER_KEY_COMMAND="security find-generic-password -a $USER -s openrouter-api-key -w"

AI_OPENROUTER_KEY=
