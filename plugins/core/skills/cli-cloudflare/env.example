# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/cli-cloudflare/.env (or to .env in this skill's directory).
# cf-token-run reads each variable from the environment first, then that file, then the
# skill-directory .env. Per token NAME set one of the two; when the command is set, the token
# line is ignored.

# A shell command that prints the token (no quotes inside the value); a failing command stops
# the run. Example for macOS login-keychain items:
#CLOUDFLARE_API_TOKEN_KV_RO_COMMAND="security find-generic-password -a $USER -s com.cloudflare.kv_reader -w"
#CLOUDFLARE_API_TOKEN_KV_RW_COMMAND="security find-generic-password -a $USER -s com.cloudflare.kv_writer -w"

#CLOUDFLARE_API_TOKEN_KV_RO=
#CLOUDFLARE_ACCOUNT_ID=
