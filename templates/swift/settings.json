{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "starterkit": {
      "source": {
        "source": "github",
        "repo": "prorochestvo/starterkit"
      }
    }
  },
  "enabledPlugins": {
    "pipeline@starterkit": true,
    "knowledge@starterkit": true
  },
  "permissions": {
    "allow": [
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift run:*)",
      "Bash(swift package:*)",
      "Bash(swift format:*)",
      "Bash(swift --version)",
      "Bash(make:*)"
    ],
    "deny": []
  }
}
