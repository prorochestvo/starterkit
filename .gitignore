# macOS
.DS_Store

# IDE / editor
.idea/
.vscode/
*.iml
*.swp

# Claude Code local overrides
**/.claude/settings.local.json

# Logs
*.log

# Books are local raw material for the knowledge skills — never committed
books/**

# Python bytecode
__pycache__/
*.pyc

# Keys: a skill keeps only its env.example in the repository
**/.env
**/.env.*
!**/env.example

# Claude Code state written into a checkout
**/.claude/agent-memory/
**/.claude/*.local.*
plugins/**/.claude/
runtime-state/
