# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/cli-openrouter/.env (or to .env in this skill's directory).
# openrouter-cli and codex-openrouter read the environment first, then that file, then the skill-directory .env,
# then the macOS keychain item a MACOS_KEYCHAIN_* line names.

AI_OPENROUTER_KEY=

# macOS: name of the login-keychain item (account $USER) that holds the key
MACOS_KEYCHAIN_AI_OPENROUTER_KEY="openrouter-api-key"
