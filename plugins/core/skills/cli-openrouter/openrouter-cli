#!/usr/bin/env python3
"""OpenRouter text API client for model queries and independent reviews.

Reads AI_OPENROUTER_KEY from the environment, then from
${XDG_CONFIG_HOME:-$HOME/.config}/cli-openrouter/.env, then from the .env in this
skill's directory; when one of those sets MACOS_KEYCHAIN_AI_OPENROUTER_KEY, the keychain
item of that service is tried last. Sends one chat
completion, prints the answer on stdout and a cost line on stderr.

Usage:
  or [-t TIER|-m MODEL] [-s SYSTEM] [-n MAX_TOKENS] [-T TEMP] [--think] [PROMPT]
  or budget
  or models [SUBSTRING]

With no PROMPT argument stdin becomes the prompt; with both, stdin is
appended as a <context> block.
"""
import argparse
import json
import os
import stat
import sys
import time
import urllib.error
import urllib.request

API = "https://openrouter.ai/api/v1"
# Key files in lookup order: the user's XDG configuration, then the skill directory (found
# from this file's real path, so it holds in any checkout or plugin cache).
ENV_FILES = (
    os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config"),
                 "cli-openrouter", ".env"),
    os.path.join(os.path.dirname(os.path.realpath(__file__)), ".env"),
)
KEY_VAR = "AI_OPENROUTER_KEY"
KEYCHAIN_VAR = "MACOS_KEYCHAIN_AI_OPENROUTER_KEY"


def model_id(alias):
    """OpenRouter id for a model alias from model-id on PATH; None when it does not resolve."""
    import subprocess
    try:
        out = subprocess.run(["model-id", "--openrouter", alias],
                             capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    return out or None


# Verified against the live catalog on 2026-09-17. Each tier is a primary
# model plus fallbacks; OpenRouter walks the list when a provider 429s.
TIERS = {
    "free": [
        "openrouter/free",
        "nvidia/nemotron-3.5-lightning:free",
        "google/gemma-4-31b-it:free",
    ],
    "cheap": [
        "qwen/qwen3.7-flash",
        "openai/gpt-4.1-nano",
        "mistralai/ministral-8b-2512",
    ],
    # luna follows the codex skill's id (bin/model-id); gpt-5-mini is the fallback.
    "luna": [m for m in (model_id("luna"), "openai/gpt-5-mini") if m],
}


def catalog_entry(alias):
    """The models.toml entry whose table name is ALIAS, at any depth under [models]
    (entries sit under country and vendor tables), or None. tomllib needs Python 3.11+;
    on an older interpreter the catalog is skipped and model-id's aliases still apply."""
    try:
        import tomllib
    except ImportError:
        return None
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "models.toml")
    try:
        with open(path, "rb") as fh:
            tables = [tomllib.load(fh).get("models", {})]
    except (OSError, tomllib.TOMLDecodeError) as exc:
        die("cannot read models.toml: %s" % exc)
    while tables:
        table = tables.pop()
        for key, value in table.items():
            if not isinstance(value, dict):
                continue
            if key == alias and "name" in value:
                return value
            tables.append(value)
    return None


def resolve_model(value):
    """Resolve curated aliases; raw OpenRouter model IDs pass through unchanged."""
    if "/" in value:
        return value
    entry = catalog_entry(value)
    if entry is not None:
        model = entry.get("id", "")
        if not model:
            die("model alias '%s' has no verified OpenRouter id; check the live catalog and update models.toml" % value)
        return model
    resolved = model_id(value)
    if resolved:
        return resolved
    die("unknown model alias '%s'; use an OpenRouter provider/model ID or configure models.toml" % value)


def die(msg, code=1):
    sys.stderr.write("or: %s\n" % msg)
    sys.exit(code)


def env_file_value(var, path):
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if line.startswith("export "):
                    line = line[7:]
                name, _, value = line.partition("=")
                if name.strip() == var:
                    return value.strip().strip("'\"") or None
    except OSError:
        pass
    return None


def env_files_value(var):
    """The first value of var across ENV_FILES; None when no file sets it."""
    for path in ENV_FILES:
        value = env_file_value(var, path)
        if value:
            return value
    return None


def keychain_key():
    """The key from the keychain service a .env names; None when unset, off macOS, or missing."""
    service = os.environ.get(KEYCHAIN_VAR) or env_files_value(KEYCHAIN_VAR)
    if not service or sys.platform != "darwin":
        return None
    import subprocess
    try:
        out = subprocess.run(["security", "find-generic-password", "-a", os.environ.get("USER", ""),
                              "-s", service, "-w"],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else None


# Keys in lookup order: environment, the XDG .env, the skill-directory .env,
# then the keychain service a .env names. A key the API rejects with 401 is
# dropped and the next one is tried, so a stale .env key falls through.
_keys = None


def api_key():
    global _keys
    if _keys is None:
        _keys = []
        getters = [lambda: os.environ.get(KEY_VAR)]
        getters += [lambda p=p: env_file_value(KEY_VAR, p) for p in ENV_FILES]
        for get in getters + [keychain_key]:
            key = get()
            if key and key not in _keys:
                _keys.append(key)
    if not _keys:
        die("no key: %s is not in the environment, %s or %s, and no keychain item is named by %s"
            % (KEY_VAR, ENV_FILES[0], ENV_FILES[1], KEYCHAIN_VAR))
    return _keys[0]


def request(path, payload=None, timeout=180):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(
        API + path,
        data=data,
        headers={
            "Authorization": "Bearer " + api_key(),
            "Content-Type": "application/json",
            "X-Title": "claude-code",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        if exc.code == 401:
            _keys.pop(0)
            if _keys:
                return request(path, payload, timeout)
            die("HTTP 401: every key was rejected (environment, %s, %s, keychain)" % ENV_FILES)
        body = exc.read().decode(errors="replace")
        try:
            return json.loads(body)
        except ValueError:
            die("HTTP %s: %s" % (exc.code, body[:300]))
    except urllib.error.URLError as exc:
        die("network: %s" % exc.reason)


def cmd_budget():
    key = request("/key")["data"]
    credits = request("/credits")["data"]
    free = key.get("free_model_daily_requests") or {}
    limit = key.get("limit")
    used = key.get("usage_monthly", 0.0)
    cap = "$%.2f" % limit if limit is not None else "none"
    print("monthly spend : $%.4f of %s (%s reset)" % (used, cap, key.get("limit_reset")))
    print("account       : $%.4f used of $%.2f credits"
          % (credits.get("total_usage", 0.0), credits.get("total_credits", 0.0)))
    print("free requests : %s of %s used today"
          % (free.get("used", "?"), free.get("limit", "?")))


def cmd_models(needle):
    data = request("/models", timeout=60)["data"]
    rows = []
    for m in data:
        mid = m["id"]
        if needle and needle.lower() not in mid.lower():
            continue
        p = float(m["pricing"]["prompt"]) * 1e6
        c = float(m["pricing"]["completion"]) * 1e6
        rows.append((p, mid, c, m.get("context_length") or 0))
    for p, mid, c, ctx in sorted(rows):
        print("%-52s in=$%-8.3f out=$%-8.3f ctx=%s" % (mid, p, c, ctx))


def read_stdin():
    """Read stdin only when something is actually piped or redirected in.

    isatty() is not enough: under a non-interactive runner stdin is often
    /dev/null or a closed char device, and a bare read() there blocks forever.
    """
    try:
        mode = os.fstat(sys.stdin.fileno()).st_mode
    except OSError:
        return ""
    if stat.S_ISFIFO(mode) or stat.S_ISREG(mode):
        return sys.stdin.read().strip()
    return ""


def cmd_ask(args):
    stdin_text = read_stdin()
    if args.prompt and stdin_text:
        user = "%s\n\n<context>\n%s\n</context>" % (args.prompt, stdin_text)
    else:
        user = args.prompt or stdin_text
    if not user.strip():
        die("empty prompt: pass one as an argument or on stdin")

    messages = []
    if args.system:
        messages.append({"role": "system", "content": args.system})
    messages.append({"role": "user", "content": user})

    payload = {
        "messages": messages,
        "temperature": args.temperature,
        "usage": {"include": True},
    }
    if args.model:
        payload["model"] = resolve_model(args.model)
    else:
        chain = TIERS[args.tier]
        payload["model"] = chain[0]
        if len(chain) > 1:
            payload["models"] = chain
    if args.max_tokens:
        payload["max_tokens"] = args.max_tokens
    # Reasoning is dead weight on rewrite/classify work and inflates billed
    # tokens by an order of magnitude on hybrid models.
    payload["reasoning"] = {"effort": args.think} if args.think else {"enabled": False}

    for attempt in range(3):
        result = request("/chat/completions", payload, timeout=args.timeout)
        if "error" not in result:
            break
        code = str(result["error"].get("code"))
        if code in ("429", "502", "503") and attempt < 2:
            time.sleep(2 * (attempt + 1))
            continue
        die("%s: %s" % (code, result["error"].get("message", "")))

    choice = result["choices"][0]["message"]
    text = (choice.get("content") or "").strip()
    if not text:
        die("model returned empty content (finish_reason=%s)"
            % result["choices"][0].get("finish_reason"))
    print(text)

    usage = result.get("usage") or {}
    sys.stderr.write("[openrouter] %s  tokens=%s  cost=$%.6f\n"
                     % (result.get("model"), usage.get("total_tokens", "?"),
                        usage.get("cost", 0.0)))


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "budget":
        return cmd_budget()
    if argv and argv[0] == "models":
        return cmd_models(argv[1] if len(argv) > 1 else None)

    ap = argparse.ArgumentParser(prog="or", add_help=True)
    ap.add_argument("prompt", nargs="?", default="")
    ap.add_argument("-t", "--tier", choices=sorted(TIERS), default="free")
    ap.add_argument("-m", "--model", help="OpenRouter provider/model ID or models.toml alias; overrides --tier")
    ap.add_argument("-s", "--system", default="")
    ap.add_argument("-n", "--max-tokens", type=int)
    ap.add_argument("-T", "--temperature", type=float, default=0.0)
    ap.add_argument("--timeout", type=int, default=180,
                    help="per-request timeout in seconds")
    ap.add_argument("--think", nargs="?", const="low",
                    choices=["low", "medium", "high"],
                    help="enable reasoning (off by default)")
    cmd_ask(ap.parse_args(argv))


if __name__ == "__main__":
    main()
