# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/cli-cloudflare/.env (or to .env in this skill's directory).
# cf-token-run reads CLOUDFLARE_API_TOKEN_<NAME> from the environment first, then from that
# file, then from the skill-directory .env, then the macOS keychain item that
# MACOS_KEYCHAIN_CLOUDFLARE_<NAME> names.
#CLOUDFLARE_API_TOKEN_KV_RO=
#CLOUDFLARE_ACCOUNT_ID=

# macOS: names of the login-keychain items (account $USER) that hold scoped API tokens
MACOS_KEYCHAIN_CLOUDFLARE_KV_RO="com.cloudflare.kv_reader"
MACOS_KEYCHAIN_CLOUDFLARE_KV_RW="com.cloudflare.kv_writer"
